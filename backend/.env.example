# Native development only. Container deployments use infra/<mode>/backend.env.
# PostgreSQL and three Redis servers must be reachable at the addresses below.
DEBUG=True
QUANTNEST_DEPLOYMENT_MODE=development
SECRET_KEY=replace-with-at-least-50-random-characters
CREDENTIAL_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=quantnest_development
DB_USER=quantnest
DB_PASSWORD=replace-with-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
MARKET_CACHE_URL=redis://127.0.0.1:6379/2
RUNTIME_REDIS_URL=redis://127.0.0.1:6381/0
RESEARCH_CACHE_URL=redis://127.0.0.1:6380/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=QuantNest <no-reply@localhost>
EXECUTION_ENABLED_SCOPES=paper
EXECUTION_MAX_ACTORS=8
EXECUTION_MAX_USER_ACTORS=4
RESEARCH_SERVICE_TOKEN=replace-with-the-same-token-in-research-service
RESEARCH_SERVICE_URL=http://127.0.0.1:8001
FYERS_CLIENT_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/market/fyers/callback/
# Set a strong token only for intentional local public-mode checks via Vite.
QUANTNEST_PROXY_TOKEN=
