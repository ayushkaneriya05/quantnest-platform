# AI provider only; Compose supplies the internal Django tool URL.
# RESEARCH_SERVICE_TOKEN must exactly match this mode's backend.env.
RESEARCH_SERVICE_TOKEN=replace-with-a-shared-random-service-token
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Use a model enabled in your Gemini project; the application default is shown.
RESEARCH_PROVIDER=gemini
RESEARCH_MODEL=gemini-3.5-flash
# Faster responses; select a thinking level supported by your model.
GEMINI_THINKING_LEVEL=low
# Total seconds for one model round, including connection and retry.
RESEARCH_PROVIDER_TIMEOUT_SECONDS=60
