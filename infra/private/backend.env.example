# Compose deployment file; copy beside this example as backend.env.
# Compose owns mode, debug policy, internal DB/Redis addresses and notification IPs.
# Every replace-with-* value below must be replaced before production deployment.
QUANTNEST_RELEASE=reviewed-release-id
SECRET_KEY=replace-with-at-least-50-random-characters
CREDENTIAL_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-admin-password
DB_NAME=quantnest
DB_USER=quantnest
DB_PASSWORD=replace-with-a-unique-application-password
# Generate hexadecimal Redis passwords to avoid URL escaping.
REDIS_PASSWORD=replace-with-64-hex-characters
QUANTNEST_PROXY_TOKEN=replace-with-a-random-ingress-token-at-least-32-characters

# Application origin: browser callbacks use this website, never the container host.
FRONTEND_URL=https://quantnest.customer-domain.example
BACKEND_URL=https://quantnest.customer-domain.example
PUBLIC_HOSTNAME=quantnest.customer-domain.example
ALLOWED_HOSTS=quantnest.customer-domain.example,api,localhost,127.0.0.1

# Brevo SMTP: host smtp-relay.brevo.com, port 587 and STARTTLS are code defaults.
EMAIL_HOST_USER=replace-with-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
DEFAULT_FROM_EMAIL=QuantNest <replace-with-verified-sender-address>

# Source authorization is separate from a customer's Live broker credentials.
FYERS_CLIENT_ID=replace-with-fyers-data-app-id
FYERS_SECRET=replace-with-fyers-data-app-secret

# Execution app registered by this installation's operator.
BROKER_FYERS_CLIENT_ID=replace-with-fyers-execution-app-id
BROKER_FYERS_SECRET=replace-with-fyers-execution-app-secret

# Issued by QuantNest; never install the central OCI private signing key here.
LICENSE_INSTALLATION_ID=replace-with-issued-installation-id
LICENSE_ACTIVATION_TOKEN=replace-with-issued-activation-token
LICENSE_SERVER_URL=https://quantnest.site

# AI service: generate one token and copy it exactly to research.env.
RESEARCH_SERVICE_TOKEN=replace-with-a-shared-random-service-token
# Public contact/newsletter forms: match the frontend site key.
# Callback URLs and allowed widget hostname derive from BACKEND_URL/FRONTEND_URL.
TURNSTILE_SECRET_KEY=

# Optional features: leave empty until their provider is configured.
# Brevo API/DOI fields enable newsletters; inbound domain enables email replies.
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
BREVO_NEWSLETTER_LIST_ID=0
BREVO_DOI_TEMPLATE_ID=0
BREVO_INBOUND_DOMAIN=

# Initial 2 OCPU/12 GB single-node capacity, not a customer-count guarantee.
EXECUTION_MAX_ACTORS=8
EXECUTION_MAX_USER_ACTORS=4
# Node count/index (1/0), execution shards (64) and order partitions (16)
# use application defaults. Keep them identical across all processes.
