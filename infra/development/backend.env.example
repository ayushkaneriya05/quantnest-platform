# Local Docker Compose only. These example credentials are not production secrets.
# Compose supplies development mode, DEBUG=True, Redis-backed Channels and DB/Redis hosts.
SECRET_KEY=local-development-only-signing-key-do-not-reuse-outside-this-machine
CREDENTIAL_ENCRYPTION_KEYS=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
POSTGRES_ADMIN_PASSWORD=local-development-admin-password
DB_NAME=quantnest_development
DB_USER=quantnest
DB_PASSWORD=local-only-database-password
REDIS_PASSWORD=a1b2c3d4e5f60123456789abcdef0123456789abcdef0123456789abcdef01234567
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,api
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=QuantNest <no-reply@localhost>
RESEARCH_SERVICE_TOKEN=local-development-research-token-change-for-shared-env

# Fill only when using the --profile market-data service.
FYERS_CLIENT_ID=
FYERS_SECRET=

# Paper is the default. For intentional real broker development, use paper,live
# together with --profile live. Save your individual app in Broker Integration.
EXECUTION_ENABLED_SCOPES=paper
