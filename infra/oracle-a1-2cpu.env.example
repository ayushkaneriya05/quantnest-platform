# Starting runtime profile for one Oracle A1 VM: 2 OCPUs / 12 GB RAM.
# Merge into the deployment environment; this is not a complete secrets file.
# These are conservative engineering defaults, not a measured Oracle capacity.
EXECUTION_ENABLED_SCOPES=paper
EXECUTION_WORKERS=1
CALCULATION_WORKERS=1
ORDER_WORKERS=1
ORDER_CONCURRENCY=2
CALCULATION_CACHE_MB=32
EXECUTION_MAX_ACTORS=8
EXECUTION_MAX_USER_ACTORS=4
EXECUTION_NODE_COUNT=1
EXECUTION_NODE_INDEX=0
EXECUTION_SHARDS=64
ORDER_PARTITIONS=16
EXECUTION_SCAN_INTERVAL=0.005
EXECUTION_TICK_BATCH=128
EXECUTION_TASK_TIMEOUT=10
EXECUTION_STARTUP_TASK_TIMEOUT=60
ORDER_TASK_TIMEOUT=30
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMBA_NUM_THREADS=1
