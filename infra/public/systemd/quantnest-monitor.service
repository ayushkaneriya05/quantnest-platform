[Unit]
Description=QuantNest deployment metrics and readiness heartbeat
After=docker.service

[Service]
Type=oneshot
User=quantnest
WorkingDirectory=/opt/quantnest/current
EnvironmentFile=/etc/quantnest/operations.env
ExecStart=/opt/quantnest/operations/bin/python infra/public/scripts/monitor.py --root /opt/quantnest/current --compartment-ocid ${OCI_COMPARTMENT_OCID} --instance-ocid ${OCI_INSTANCE_OCID}
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
