[Unit]
Description=QuantNest encrypted Oracle backup
After=docker.service

[Service]
Type=oneshot
User=quantnest
WorkingDirectory=/opt/quantnest/current
EnvironmentFile=/etc/quantnest/operations.env
ExecStart=/opt/quantnest/operations/bin/python infra/shared/scripts/backup.py --root /opt/quantnest/current --mode public --output ${QUANTNEST_BACKUP_DIRECTORY} --recipient ${BACKUP_AGE_RECIPIENT} --namespace ${OCI_OBJECT_NAMESPACE} --bucket ${OCI_BACKUP_BUCKET}
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
