# Copy to terraform.tfvars and fill the identifiers from your OCI Console.
# This template contains no private SSH key, application secrets or API signing key.
region                = "replace-with-home-region"
tenancy_ocid          = "ocid1.tenancy.oc1..replace-me"
compartment_ocid      = "ocid1.compartment.oc1..replace-me"
availability_domain   = "replace-with-availability-domain-name"
ubuntu_arm_image_ocid = "ocid1.image.oc1..replace-with-ubuntu-24-04-arm64-image"
ssh_public_key        = "ssh-ed25519 replace-with-your-public-key"
admin_cidr            = "203.0.113.10/32" # Replace with your actual administrator IPv4.
operations_email      = "ayushkaneriya05@gmail.com"
backup_retention_days = 14

# Reviewed against https://www.cloudflare.com/ips-v4/ on 2026-10-15.
# Fetch and compare the current list before applying a network change.
ingress_cidrs = [
  "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
  "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
  "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
  "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22",
]
