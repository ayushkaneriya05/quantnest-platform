# Oracle host operations for the public QuantNest deployment.
# Store as /etc/quantnest/operations.env with owner-only permissions.
QUANTNEST_DATA_DIRECTORY=/mnt/quantnest-data
QUANTNEST_BACKUP_DIRECTORY=/mnt/quantnest-data/backups
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me
OCI_INSTANCE_OCID=ocid1.instance.oc1..replace-me
OCI_OBJECT_NAMESPACE=replace-with-object-storage-namespace
OCI_BACKUP_BUCKET=quantnest-encrypted-backups
BACKUP_AGE_RECIPIENT=age1replace-with-the-public-backup-recipient

# Optional central Private release packaging; separate from the licence key.
# Leave empty until issuing signed software releases on this Oracle host.
OCI_RELEASE_KEY_ID=
OCI_RELEASE_KEY_VERSION=
OCI_RELEASE_SIGNING_ENDPOINT=
