[Unit]
Description=QuantNest background queue %i
After=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=quantnest
Group=quantnest
WorkingDirectory=/opt/quantnest/backend
EnvironmentFile=/etc/quantnest/backend.env
ExecStart=/opt/quantnest/.venv/bin/celery -A backend worker --queues=%i --concurrency=1 --prefetch-multiplier=1 --max-tasks-per-child=100 --max-memory-per-child=750000 --hostname=%i@%%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
Nice=10
CPUWeight=25
MemoryHigh=1G
MemoryMax=1500M
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
