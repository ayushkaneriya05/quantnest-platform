[Unit]
Description=QuantNest runtime %i
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=quantnest
Group=quantnest
WorkingDirectory=/opt/quantnest/backend
EnvironmentFile=/etc/quantnest/backend.env
Environment=QUANTNEST_RUNTIME_DIR=/var/lib/quantnest/market
ExecStart=/opt/quantnest/.venv/bin/python -m quantnest_runtime %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StateDirectory=quantnest
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quantnest /opt/quantnest/backend/logs
LimitNOFILE=65536
TasksMax=256

[Install]
WantedBy=multi-user.target
